# Optional local provider credentials.
# On Netlify, AI Gateway injects these automatically. If you set your own keys
# in Netlify, they take precedence while remaining server-side.

OPENAI_API_KEY=
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Email confirmation (Resend). Set these in Netlify -> Environment variables.
# Never commit a real key.
RESEND_API_KEY=
# Optional: a sender on a domain you verified in Resend, e.g. "JayCode <no-reply@yourdomain.com>".
# Defaults to Resend's test sender, which can only email your own Resend account address.
EMAIL_FROM=
# Optional: separate secret for signing confirmation links (defaults to RESEND_API_KEY).
EMAIL_VERIFY_SECRET=
